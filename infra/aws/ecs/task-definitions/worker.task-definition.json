{
  "family": "collabsphere-worker",
  "executionRoleArn": "__ECS_EXECUTION_ROLE_ARN__",
  "taskRoleArn": "__ECS_TASK_ROLE_ARN__",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "runtimePlatform": {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  },
  "containerDefinitions": [
    {
      "name": "worker",
      "image": "__WORKER_IMAGE__",
      "essential": true,
      "environment": [
        { "name": "WORKER_HEARTBEAT_MS", "value": "5000" },
        { "name": "JWT_ACCESS_TTL_MINUTES", "value": "15" },
        { "name": "REFRESH_TOKEN_TTL_DAYS", "value": "7" }
      ],
      "secrets": [
        { "name": "DATABASE_URL", "valueFrom": "__DATABASE_URL_SECRET_ARN__" },
        { "name": "REDIS_URL", "valueFrom": "__REDIS_URL_SECRET_ARN__" },
        { "name": "JWT_ACCESS_SECRET", "valueFrom": "__JWT_ACCESS_SECRET_ARN__" },
        { "name": "CORS_ORIGINS", "valueFrom": "__CORS_ORIGINS_SECRET_ARN__" },
        { "name": "EMAIL_PROVIDER_API_KEY", "valueFrom": "__EMAIL_PROVIDER_API_KEY_SECRET_ARN__" },
        { "name": "API_BASE_URL", "valueFrom": "__API_BASE_URL_SECRET_ARN__" },
        { "name": "BASE_URL", "valueFrom": "__BASE_URL_SECRET_ARN__" },
        { "name": "COLLAB_DATABASE_URL", "valueFrom": "__COLLAB_DATABASE_URL_SECRET_ARN__" },
        { "name": "COLLAB_REDIS_URL", "valueFrom": "__COLLAB_REDIS_URL_SECRET_ARN__" },
        { "name": "COLLAB_JWT_SECRET", "valueFrom": "__COLLAB_JWT_SECRET_ARN__" },
        { "name": "COLLAB_WS_URL", "valueFrom": "__COLLAB_WS_URL_SECRET_ARN__" },
        { "name": "S3_BUCKET", "valueFrom": "__S3_BUCKET_SECRET_ARN__" },
        { "name": "S3_ACCESS_KEY_ID", "valueFrom": "__S3_ACCESS_KEY_ID_SECRET_ARN__" },
        { "name": "S3_SECRET_ACCESS_KEY", "valueFrom": "__S3_SECRET_ACCESS_KEY_SECRET_ARN__" },
        { "name": "S3_REGION", "valueFrom": "__S3_REGION_SECRET_ARN__" },
        { "name": "S3_ENDPOINT", "valueFrom": "__S3_ENDPOINT_SECRET_ARN__" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/collabsphere-production/worker",
          "awslogs-region": "__AWS_REGION__",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
