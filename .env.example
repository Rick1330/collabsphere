# Docker Compose local infrastructure defaults
# Copy this file to `.env` to override Docker Compose ports or local infra
# credentials. If a host port is already in use, update the matching `*_PORT`
# value in `.env` before rerunning `docker compose up -d`.
# This file currently covers Docker Compose infrastructure keys only. Additional
# application runtime env vars will be added alongside the app bootstrap work.
POSTGRES_PORT=5432
POSTGRES_USER=collab
POSTGRES_PASSWORD=collab
POSTGRES_DB=collabsphere

REDIS_PORT=6379

MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025

# Enable MinIO only when needed, for example:
# COMPOSE_PROFILES=minio
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
