# CollabSphere local environment example
# Use this file as the source for both local env surfaces:
# - copy the whole file to `.env` so Docker Compose gets infrastructure keys and
#   app processes get the shared local runtime defaults
# - copy machine-specific runtime overrides into `.env.local` only when a
#   developer needs values that differ from the shared defaults
# Never commit `.env.local`.
#
# Values below match the current `docker-compose.yml` defaults and the canonical
# local-development env contracts from `docs/spec/07-architecture/07.5-*` and
# `docs/spec/14-devops/14.3-*`.

# Docker Compose infrastructure defaults
# Update `*_PORT` values in `.env` if the host port is already in use before
# rerunning `docker compose up -d`.
# If you override a published port here, also update any corresponding runtime
# URL below (`DATABASE_URL`, `REDIS_URL`, `COLLAB_*_URL`, `S3_ENDPOINT`).
POSTGRES_DB=collabsphere
POSTGRES_PASSWORD=collab
POSTGRES_PORT=5432
POSTGRES_USER=collab

# Redis host port published by Docker Compose.
REDIS_PORT=6379

# MailHog captures outbound email locally. SMTP uses `MAILHOG_SMTP_PORT`; the
# browser UI uses `MAILHOG_UI_PORT`.
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025

# MinIO stays disabled unless the `minio` profile is enabled explicitly, for
# example with `docker compose --profile minio up -d`.
# COMPOSE_PROFILES=minio
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ROOT_USER=minioadmin

# Application runtime defaults
# These runtime variables are validated at startup. Unless noted as optional,
# they are required by the current shared runtime contract. Local dev validation
# treats every key listed in this file as required in `.env` / `.env.local`,
# even if the runtime contract marks a key optional.
# Host-run services connect through the published Docker ports above.
DATABASE_URL=postgresql://collab:collab@localhost:5432/collabsphere
REDIS_URL=redis://localhost:6379

# Local-only auth placeholders. Replace these outside local development.
# TTLs are positive integers (minutes / days).
JWT_ACCESS_SECRET=replace-with-local-jwt-secret
JWT_ACCESS_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# MailHog handles local email capture, so this provider key can stay a
# placeholder unless you are intentionally testing a real email provider.
EMAIL_PROVIDER_API_KEY=replace-with-local-email-key

# Base URLs for local web and API development.
# CORS_ORIGINS is a comma-separated list of bare origins (scheme + host + optional port).
API_BASE_URL=http://localhost:3001
BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Collaboration service defaults share the same local Postgres and Redis.
# COLLAB_WS_URL must be ws:// or wss://.
COLLAB_DATABASE_URL=postgresql://collab:collab@localhost:5432/collabsphere
COLLAB_JWT_SECRET=replace-with-local-collab-secret
# Optional at runtime: set if collab uses a dedicated Redis. Still required in
# local `.env` because it is listed in this file.
COLLAB_REDIS_URL=redis://localhost:6379
COLLAB_WS_URL=ws://localhost:3001/collaboration

# Object storage defaults for local file development when MinIO is enabled.
# S3_ENDPOINT is optional at runtime (required only for non-AWS endpoints like
# MinIO). It is still required in local `.env` because it is listed in this file.
# The other S3_* values are required by the current runtime contract.
S3_ACCESS_KEY_ID=minioadmin
S3_BUCKET=collabsphere-local
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_SECRET_ACCESS_KEY=minioadmin
